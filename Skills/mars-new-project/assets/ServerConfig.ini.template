[DefaultEngine]
;BasePath=/rest
;Port=8080
;PortSSL=0
ThreadPoolSize=100

;DefaultApp.JWT.Issuer=MARS-Curiosity
;DefaultApp.JWT.Secret={{PROJECT_NAME}}_change_this_secret
;Key rotation: JWT.KeyId names JWT.Secret (sent as "kid" in the tokens); a retired secret stays
;valid for verification as JWT.PreviousSecret.<its KeyId>, or JWT.PreviousSecret if it had no KeyId.
;DefaultApp.JWT.KeyId=
;DefaultApp.JWT.PreviousSecret.<kid>=
;DefaultApp.JWT.PreviousSecret=
;DefaultApp.JWT.CookieEnabled=true
;DefaultApp.JWT.CookieName=access_token
;DefaultApp.JWT.CookieDomain=
;DefaultApp.JWT.CookiePath=
;DefaultApp.JWT.Duration=1
;DefaultApp.JWT.Duration.InSeconds=3600
;DefaultApp.JWT.Duration.InMinutes=60
;DefaultApp.JWT.CookieSecure=false

;JSON responses: false writes non-ASCII characters as they are instead of \uXXXX escapes
;DefaultApp.JSON.EscapeNonASCII=true

;Compression.Enabled=True

;CORS.Enabled=True
;CORS.Origin=*
;CORS.Methods=HEAD,GET,PUT,POST,DELETE,OPTIONS
;CORS.Headers=X-Requested-With,Content-Type,Authorization

;Indy.SSL.RootCertFile=localhost.pem
;Indy.SSL.CertFile=localhost.crt
;Indy.SSL.KeyFile=localhost.key
;Indy.SSL.Version=sslvTLSv1_2
;Indy.SSL.Mode=sslmServer

;OpenAPI.info.title={{PROJECT_NAME}}
;OpenAPI.info.description={{PROJECT_NAME}} REST API
;OpenAPI.info.version=0.1.0

;FireDAC.MAIN_DB.DriverID=FB
;FireDAC.MAIN_DB.Database=C:\data\MAIN_DB.FDB
;FireDAC.MAIN_DB.User_Name=SYSDBA
;FireDAC.MAIN_DB.Password=masterkey
;FireDAC.MAIN_DB.Protocol=TCPIP
;FireDAC.MAIN_DB.Server=localhost
;FireDAC.MAIN_DB.Pooled=True
;FireDAC.MAIN_DB.POOL_MaximumItems=100
