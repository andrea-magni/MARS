package MARS.mORMot;

{$R *.res}
{$IFDEF IMPLICITBUILDING This IFDEF should not be used by users}
{$ALIGN 8}
{$ASSERTIONS ON}
{$BOOLEVAL OFF}
{$DEBUGINFO OFF}
{$EXTENDEDSYNTAX ON}
{$IMPORTEDDATA ON}
{$IOCHECKS ON}
{$LOCALSYMBOLS OFF}
{$LONGSTRINGS ON}
{$OPENSTRINGS ON}
{$OPTIMIZATION ON}
{$OVERFLOWCHECKS OFF}
{$RANGECHECKS OFF}
{$REFERENCEINFO OFF}
{$SAFEDIVIDE OFF}
{$STACKFRAMES OFF}
{$TYPEDADDRESS OFF}
{$VARSTRINGCHECKS ON}
{$WRITEABLECONST OFF}
{$MINENUMSIZE 1}
{$IMAGEBASE $400000}
{$DEFINE RELEASE}
{$ENDIF IMPLICITBUILDING}
{$DESCRIPTION 'MARS-Curiosity mORMot JWT'}
{$LIBSUFFIX AUTO}
{$RUNONLY}
{$IMPLICITBUILD OFF}
{$WARN DUPLICATE_CTOR_DTOR OFF}

requires
  rtl,
  IndySystem,
  IndyProtocols,
  IndyCore,
  MARS.Utils,
  MARS.Core;

contains
  MARS.mORMotJWT.Token in '..\..\Source\MARS.mORMotJWT.Token.pas',
  MARS.mORMotJWT.Token.InjectionService in '..\..\Source\MARS.mORMotJWT.Token.InjectionService.pas',
  mormot.core.base in '..\..\ThirdParty\mORMot2\src\core\mormot.core.base.pas',
  mormot.core.os in '..\..\ThirdParty\mORMot2\src\core\mormot.core.os.pas',
  mormot.core.os.security in '..\..\ThirdParty\mORMot2\src\core\mormot.core.os.security.pas',
  mormot.core.unicode in '..\..\ThirdParty\mORMot2\src\core\mormot.core.unicode.pas',
  mormot.core.text in '..\..\ThirdParty\mORMot2\src\core\mormot.core.text.pas',
  mormot.core.datetime in '..\..\ThirdParty\mORMot2\src\core\mormot.core.datetime.pas',
  mormot.core.rtti in '..\..\ThirdParty\mORMot2\src\core\mormot.core.rtti.pas',
  mormot.core.buffers in '..\..\ThirdParty\mORMot2\src\core\mormot.core.buffers.pas',
  mormot.core.data in '..\..\ThirdParty\mORMot2\src\core\mormot.core.data.pas',
  mormot.core.json in '..\..\ThirdParty\mORMot2\src\core\mormot.core.json.pas',
  mormot.core.variants in '..\..\ThirdParty\mORMot2\src\core\mormot.core.variants.pas',
  mormot.core.search in '..\..\ThirdParty\mORMot2\src\core\mormot.core.search.pas',
  mormot.core.fmt in '..\..\ThirdParty\mORMot2\src\core\mormot.core.fmt.pas',
  mormot.lib.sspi in '..\..\ThirdParty\mORMot2\src\lib\mormot.lib.sspi.pas',
  mormot.crypt.core in '..\..\ThirdParty\mORMot2\src\crypt\mormot.crypt.core.pas',
  mormot.crypt.secure in '..\..\ThirdParty\mORMot2\src\crypt\mormot.crypt.secure.pas',
  mormot.crypt.ecc256r1 in '..\..\ThirdParty\mORMot2\src\crypt\mormot.crypt.ecc256r1.pas',
  mormot.crypt.ecc in '..\..\ThirdParty\mORMot2\src\crypt\mormot.crypt.ecc.pas',
  mormot.crypt.rsa in '..\..\ThirdParty\mORMot2\src\crypt\mormot.crypt.rsa.pas',
  mormot.crypt.factory in '..\..\ThirdParty\mORMot2\src\crypt\mormot.crypt.factory.pas',
  mormot.crypt.jwt in '..\..\ThirdParty\mORMot2\src\crypt\mormot.crypt.jwt.pas';

end.
