unit MARS.Gen.Emit.Types;

// Writes the Model unit: the records and enumerations of TGenTypeMapper, as Delphi source.

interface

uses
  System.SysUtils, System.Classes,
  MARS.Gen.Model, MARS.Gen.Types, MARS.Gen.Output;

type
  TGenTypesEmitter = class
  private
    FMapper: TGenTypeMapper;
    FLines: TStringList;
    procedure Add(const ALine: string = '');
    procedure AddComments(const AComments: TArray<string>; const AIndent: string);
    procedure EmitHeader;
    procedure EmitEnum(const AType: TGenDelphiType);
    procedure EmitRecord(const AType: TGenDelphiType);
    // classes
    function IsOwned(const AField: TGenDelphiField; out ADepth: Integer): Boolean;
    function OwnsObjects(const AType: TGenDelphiType): Boolean;
    procedure EmitClass(const AType: TGenDelphiType);
    procedure EmitDestructor(const AType: TGenDelphiType);
  public
    constructor Create(const AMapper: TGenTypeMapper);
    destructor Destroy; override;
    function Execute: string;

    // the source of the unit (the mapper must have run)
    class function Emit(const AMapper: TGenTypeMapper): string; static;
    // maps and writes <unit>.pas through AOutput (manifest, files changed by hand), returning its file
    class function WriteTo(const AApi: TGenApi; const AOptions: TGenTypeOptions; const AOutput: TGenOutput): string; static;
    // maps and writes <folder>\<unit>.pas, with its manifest, returning the file name
    class function WriteUnit(const AApi: TGenApi; const AOptions: TGenTypeOptions; const AFolder: string): string; static;
  end;

implementation

uses
  System.IOUtils,
  MARS.Gen.Naming;

const
  INDENT = '  ';
  // Delphi refuses lines longer than 1023 characters (F2069): comments and enumerations wrap
  WRAP_WIDTH = 100;

{ TGenTypesEmitter }

constructor TGenTypesEmitter.Create(const AMapper: TGenTypeMapper);
begin
  inherited Create;
  FMapper := AMapper;
  FLines := TStringList.Create;
end;

destructor TGenTypesEmitter.Destroy;
begin
  FLines.Free;
  inherited;
end;

procedure TGenTypesEmitter.Add(const ALine: string);
begin
  FLines.Add(ALine);
end;

procedure TGenTypesEmitter.AddComments(const AComments: TArray<string>; const AIndent: string);
begin
  for var LLine in AComments do
    if LLine.Trim = '' then
      Add(AIndent + '//')
    else
      for var LWrapped in TGenNaming.WrapWords(LLine, WRAP_WIDTH) do
        Add(AIndent + '// ' + LWrapped);
end;

procedure TGenTypesEmitter.EmitHeader;
var
  LApi: TGenApi;
  LSource: string;
  LUnits: TArray<string>;
begin
  LApi := FMapper.Api;
  LSource := '"' + LApi.Title + '"';
  if LApi.Version <> '' then
    LSource := LSource + ' ' + LApi.Version;
  if LApi.OpenAPIVersion <> '' then
    LSource := LSource + ' (OpenAPI ' + LApi.OpenAPIVersion + ')';

  Add('(*');
  Add('  Generated by MARSgen from ' + LSource + '.');
  Add('  Do not edit: this unit is written again when the document is imported again.');
  Add('*)');
  Add('unit ' + FMapper.UnitName + ';');
  Add;
  Add('interface');
  Add;
  Add('{$SCOPEDENUMS ON}');
  Add;
  LUnits := [];
  if FMapper.UsesJSONValue then
    LUnits := LUnits + ['System.JSON'];
  if FMapper.UsesRawJSON or FMapper.UsesJSONName then
    LUnits := LUnits + ['MARS.Core.JSON'];
  if Length(LUnits) > 0 then
  begin
    Add('uses');
    Add(INDENT + string.Join(', ', LUnits) + ';');
    Add;
  end;
end;

procedure TGenTypesEmitter.EmitEnum(const AType: TGenDelphiType);
var
  LNames: TArray<string>;
  LLine, LText: string;
begin
  AddComments(AType.Comments, INDENT);
  LNames := [];
  for var LValue in AType.EnumValues do
    LNames := LNames + [LValue.Name];
  LLine := INDENT + AType.Name + ' = (' + string.Join(', ', LNames) + ');';
  if Length(LLine) <= WRAP_WIDTH then
    Add(LLine)
  else
  begin
    // many values: on more lines
    Add(INDENT + AType.Name + ' = (');
    LLine := '';
    for var LIndex := 0 to High(LNames) do
    begin
      LText := LNames[LIndex];
      if LIndex < High(LNames) then
        LText := LText + ','
      else
        LText := LText + ');';
      if (LLine <> '') and (Length(LLine) + 1 + Length(LText) > WRAP_WIDTH) then
      begin
        Add(LLine);
        LLine := '';
      end;
      if LLine = '' then
        LLine := INDENT + INDENT + LText
      else
        LLine := LLine + ' ' + LText;
    end;
    Add(LLine);
  end;
  Add;
end;

procedure TGenTypesEmitter.EmitRecord(const AType: TGenDelphiType);
var
  LLine: string;
begin
  AddComments(AType.Comments, INDENT);
  Add(INDENT + AType.Name + ' = record');
  for var LField in AType.Fields do
  begin
    AddComments(LField.Comments, INDENT + INDENT);
    LLine := INDENT + INDENT;
    if LField.NeedsJSONName or FMapper.Options.JSONNameAlways then
      LLine := LLine + '[JSONName(''' + LField.JSONName.Replace('''', '''''') + ''')] ';
    Add(LLine + LField.Name + ': ' + LField.TypeName + ';');
  end;
  Add(INDENT + 'end;');
  Add;
end;

// a field the class frees: an object (a class of the unit, a TJSONValue), or an array of them;
// ADepth: the levels of TArray<>
function TGenTypesEmitter.IsOwned(const AField: TGenDelphiField; out ADepth: Integer): Boolean;
var
  LTypeName: string;
begin
  ADepth := 0;
  LTypeName := AField.TypeName;
  while LTypeName.StartsWith('TArray<') and LTypeName.EndsWith('>') do
  begin
    Inc(ADepth);
    LTypeName := LTypeName.Substring(7, Length(LTypeName) - 8);
  end;
  Result := LTypeName = JSON_VALUE_TYPE;
  if not Result then
    for var LType in FMapper.Types do
      if (LType.Kind = TGenDelphiTypeKind.Record) and (LType.Name = LTypeName) then
        Exit(True);
end;

function TGenTypesEmitter.OwnsObjects(const AType: TGenDelphiType): Boolean;
var
  LDepth: Integer;
begin
  for var LField in AType.Fields do
    if IsOwned(LField, LDepth) then
      Exit(True);
  Result := False;
end;

procedure TGenTypesEmitter.EmitClass(const AType: TGenDelphiType);
var
  LLine: string;
begin
  AddComments(AType.Comments, INDENT);
  if Assigned(AType.BaseType) then
    Add(INDENT + AType.Name + ' = class(' + AType.BaseType.Name + ')')
  else
    Add(INDENT + AType.Name + ' = class');
  Add(INDENT + 'public');
  for var LField in AType.Fields do
  begin
    AddComments(LField.Comments, INDENT + INDENT);
    LLine := INDENT + INDENT;
    if LField.NeedsJSONName or FMapper.Options.JSONNameAlways then
      LLine := LLine + '[JSONName(''' + LField.JSONName.Replace('''', '''''') + ''')] ';
    Add(LLine + LField.Name + ': ' + LField.TypeName + ';');
  end;
  if OwnsObjects(AType) then
  begin
    Add(INDENT + INDENT + '// frees the objects of the fields (MARS creates them reading JSON)');
    Add(INDENT + INDENT + 'destructor Destroy; override;');
  end;
  Add(INDENT + 'end;');
  Add;
end;

procedure TGenTypesEmitter.EmitDestructor(const AType: TGenDelphiType);
var
  LDepth: Integer;
  LItem, LIndent: string;
begin
  if not OwnsObjects(AType) then
    Exit;
  Add('destructor ' + AType.Name + '.Destroy;');
  Add('begin');
  for var LField in AType.Fields do
    if IsOwned(LField, LDepth) then
    begin
      if LDepth = 0 then
      begin
        Add(INDENT + LField.Name + '.Free;');
        Continue;
      end;
      // arrays: their elements (arrays of arrays: one loop per level)
      LItem := LField.Name;
      LIndent := INDENT;
      for var LLevel := 1 to LDepth do
      begin
        Add(LIndent + 'for var LItem' + LLevel.ToString + ' in ' + LItem + ' do');
        LItem := 'LItem' + LLevel.ToString;
        LIndent := LIndent + INDENT;
      end;
      Add(LIndent + LItem + '.Free;');
    end;
  Add(INDENT + 'inherited;');
  Add('end;');
  Add;
end;

function TGenTypesEmitter.Execute: string;
var
  LHasClasses: Boolean;
begin
  FLines.Clear;
  EmitHeader;
  LHasClasses := False;

  if FMapper.Types.Count > 0 then
  begin
    Add('type');
    for var LType in FMapper.Types do
      if LType.Kind = TGenDelphiTypeKind.Enumeration then
        EmitEnum(LType);
    if FMapper.Options.Classes then
    begin
      // declared forward: the classes reference each other in any order
      for var LType in FMapper.Types do
        if LType.Kind = TGenDelphiTypeKind.Record then
        begin
          Add(INDENT + LType.Name + ' = class;');
          LHasClasses := True;
        end;
      if LHasClasses then
        Add;
    end;
    for var LType in FMapper.Types do
      if LType.Kind = TGenDelphiTypeKind.Record then
        if FMapper.Options.Classes then
          EmitClass(LType)
        else
          EmitRecord(LType);
  end
  else
  begin
    Add('// no types: the document has no schemas that map to records or enumerations');
    Add;
  end;

  Add('implementation');
  Add;
  if LHasClasses then
    for var LType in FMapper.Types do
      if LType.Kind = TGenDelphiTypeKind.Record then
        EmitDestructor(LType);
  Add('end.');
  Result := FLines.Text;
end;

class function TGenTypesEmitter.Emit(const AMapper: TGenTypeMapper): string;
var
  LEmitter: TGenTypesEmitter;
begin
  LEmitter := TGenTypesEmitter.Create(AMapper);
  try
    Result := LEmitter.Execute;
  finally
    LEmitter.Free;
  end;
end;

class function TGenTypesEmitter.WriteTo(const AApi: TGenApi; const AOptions: TGenTypeOptions;
  const AOutput: TGenOutput): string;
var
  LMapper: TGenTypeMapper;
begin
  LMapper := TGenTypeMapper.Create(AApi, AOptions);
  try
    LMapper.Execute;
    AOutput.WriteGenerated(LMapper.UnitName + '.pas', Emit(LMapper));
    Result := TPath.Combine(AOutput.Folder, LMapper.UnitName + '.pas');
  finally
    LMapper.Free;
  end;
end;

class function TGenTypesEmitter.WriteUnit(const AApi: TGenApi; const AOptions: TGenTypeOptions;
  const AFolder: string): string;
var
  LOutput: TGenOutput;
begin
  LOutput := TGenOutput.Create(AFolder, TGenOutput.ApiName(AApi), False);
  try
    Result := WriteTo(AApi, AOptions, LOutput);
    LOutput.Finish(AApi, 'types', '', '', AOptions);
  finally
    LOutput.Free;
  end;
end;

end.
