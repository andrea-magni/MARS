unit MARS.Gen.Output;

// Writes the files of an import into a folder, keeping the code of the user:
// - a manifest (<Api>.marsgen.json) records the document, the mode, the options, the generated
//   files with their hashes, the files of the user and the operations;
// - a generated file is written again, unless it was changed by hand since the last import (its
//   hash differs from the manifest) or it exists without being in the manifest: then it is kept,
//   with a warning, unless forced;
// - a file of the user is created only when missing;
// - generated files of the last import not written now (i.e. a resource gone) and operations added
//   or removed since then are reported.

interface

uses
  System.SysUtils, System.Classes, System.JSON, System.Generics.Collections,
  MARS.Gen.Model, MARS.Gen.Types;

type
  TGenManifest = class
  private
    FDocument: string;
    FDocumentHash: string;
    FMode: string;
    FOptions: TGenTypeOptions;
    FGenerated: TDictionary<string, string>;
    FUserFiles: TList<string>;
    FOperations: TList<string>;
    FImportedAt: string;
  public
    constructor Create;
    destructor Destroy; override;
    procedure LoadFromFile(const AFileName: string);
    procedure SaveToFile(const AFileName: string);

    // the document as given (a file or a URL) and the SHA-256 of its content (empty for a URL)
    property Document: string read FDocument write FDocument;
    property DocumentHash: string read FDocumentHash write FDocumentHash;
    // types, server
    property Mode: string read FMode write FMode;
    property Options: TGenTypeOptions read FOptions write FOptions;
    // file name (in the folder) -> SHA-256 of its content when written
    property Generated: TDictionary<string, string> read FGenerated;
    property UserFiles: TList<string> read FUserFiles;
    // GET /pets, POST /pets...
    property Operations: TList<string> read FOperations;
    property ImportedAt: string read FImportedAt write FImportedAt;
  end;

  TGenOutput = class
  private
    FFolder: string;
    FManifestFile: string;
    FForce: Boolean;
    FPrevious: TGenManifest;
    FCurrent: TGenManifest;
    FWritten, FCreated, FKept, FChanged, FForeign, FStale, FUnused, FAdded, FRemoved: TArray<string>;
  public
    // AName: the name of the manifest, without .marsgen.json
    constructor Create(const AFolder, AName: string; const AForce: Boolean);
    destructor Destroy; override;

    class function HashOf(const AFileName: string): string; static;
    // the name of the manifest of an API: PetStore for "Pet Store"
    class function ApiName(const AApi: TGenApi): string; static;
    class function ManifestFileName(const AFolder, AName: string): string; static;
    // the manifest of a folder, nil when there is none (the caller owns it)
    class function LoadManifest(const AFolder, AName: string): TGenManifest; static;

    // a generated file: written unless changed by hand since the last import (or not ours)
    procedure WriteGenerated(const AFileName, AContent: string);
    // a file of the user: created only when missing
    procedure WriteUser(const AFileName, AContent: string);
    // compares with the last import, saves the manifest
    procedure Finish(const AApi: TGenApi; const AMode, ADocument, ADocumentHash: string;
      const AOptions: TGenTypeOptions);

    property Folder: string read FFolder;
    property ManifestFile: string read FManifestFile;
    // the last import, nil when this is the first one
    property Previous: TGenManifest read FPrevious;
    // full file names
    property Written: TArray<string> read FWritten;
    property Created: TArray<string> read FCreated;
    property Kept: TArray<string> read FKept;
    // generated files not written (unless forced): changed by hand since the last import...
    property Changed: TArray<string> read FChanged;
    // ...or already there without being in the manifest (not written by MARSgen)
    property Foreign: TArray<string> read FForeign;
    // generated by the last import, not by this one (still on disk)
    property Stale: TArray<string> read FStale;
    // files of the user of the last import not used by this one (i.e. a resource gone)
    property Unused: TArray<string> read FUnused;
    // operations since the last import (METHOD /path)
    property Added: TArray<string> read FAdded;
    property Removed: TArray<string> read FRemoved;
  end;

implementation

uses
  System.IOUtils, System.Hash, System.DateUtils,
  MARS.Gen.Naming;

const
  MANIFEST_EXTENSION = '.marsgen.json';
  MANIFEST_VERSION = 1;

{ TGenManifest }

constructor TGenManifest.Create;
begin
  inherited Create;
  FGenerated := TDictionary<string, string>.Create;
  FUserFiles := TList<string>.Create;
  FOperations := TList<string>.Create;
  FOptions := TGenTypeOptions.Default;
end;

destructor TGenManifest.Destroy;
begin
  FOperations.Free;
  FUserFiles.Free;
  FGenerated.Free;
  inherited;
end;

procedure TGenManifest.LoadFromFile(const AFileName: string);
var
  LRoot, LObject: TJSONObject;
  LArray: TJSONArray;
  LValue: TJSONValue;
begin
  LValue := TJSONValue.ParseJSONValue(TFile.ReadAllText(AFileName, TEncoding.UTF8));
  try
    if not (LValue is TJSONObject) then
      raise EGenError.Create('Not a MARSgen manifest: ' + AFileName);
    LRoot := TJSONObject(LValue);

    FDocument := LRoot.GetValue<string>('document', '');
    FDocumentHash := LRoot.GetValue<string>('documentHash', '');
    FMode := LRoot.GetValue<string>('mode', '');
    FImportedAt := LRoot.GetValue<string>('importedAt', '');

    LObject := LRoot.GetValue<TJSONObject>('options', nil);
    if Assigned(LObject) then
    begin
      FOptions.UnitName := LObject.GetValue<string>('unit', '');
      FOptions.IntegerWithoutFormatIs64 := LObject.GetValue<Boolean>('int64', False);
      if LObject.GetValue<Boolean>('currency', False) then
        FOptions.NumberType := TGenNumberType.Currency;
      FOptions.EnumsAsTypes := not LObject.GetValue<Boolean>('enumsAsStrings', False);
      FOptions.JSONNameAlways := LObject.GetValue<Boolean>('jsonNameAlways', False);
      FOptions.FieldNamesAsInJSON := LObject.GetValue<Boolean>('fieldNamesAsJson', False);
    end;

    LObject := LRoot.GetValue<TJSONObject>('generated', nil);
    if Assigned(LObject) then
      for var LPair in LObject do
        FGenerated.AddOrSetValue(LPair.JsonString.Value, LPair.JsonValue.Value);

    LArray := LRoot.GetValue<TJSONArray>('user', nil);
    if Assigned(LArray) then
      for var LItem in LArray do
        FUserFiles.Add(LItem.Value);

    LArray := LRoot.GetValue<TJSONArray>('operations', nil);
    if Assigned(LArray) then
      for var LItem in LArray do
        FOperations.Add(LItem.Value);
  finally
    LValue.Free;
  end;
end;

procedure TGenManifest.SaveToFile(const AFileName: string);
var
  LRoot, LObject: TJSONObject;
  LArray: TJSONArray;
  LNames: TArray<string>;
begin
  LRoot := TJSONObject.Create;
  try
    LRoot.AddPair('generator', 'MARSgen');
    LRoot.AddPair('version', TJSONNumber.Create(MANIFEST_VERSION));
    LRoot.AddPair('document', FDocument);
    LRoot.AddPair('documentHash', FDocumentHash);
    LRoot.AddPair('mode', FMode);
    LRoot.AddPair('importedAt', FImportedAt);

    LObject := TJSONObject.Create;
    LRoot.AddPair('options', LObject);
    LObject.AddPair('unit', FOptions.UnitName);
    LObject.AddPair('int64', TJSONBool.Create(FOptions.IntegerWithoutFormatIs64));
    LObject.AddPair('currency', TJSONBool.Create(FOptions.NumberType = TGenNumberType.Currency));
    LObject.AddPair('enumsAsStrings', TJSONBool.Create(not FOptions.EnumsAsTypes));
    LObject.AddPair('jsonNameAlways', TJSONBool.Create(FOptions.JSONNameAlways));
    LObject.AddPair('fieldNamesAsJson', TJSONBool.Create(FOptions.FieldNamesAsInJSON));

    // sorted: a stable file, readable in a diff
    LObject := TJSONObject.Create;
    LRoot.AddPair('generated', LObject);
    LNames := FGenerated.Keys.ToArray;
    TArray.Sort<string>(LNames);
    for var LName in LNames do
      LObject.AddPair(LName, FGenerated[LName]);

    LArray := TJSONArray.Create;
    LRoot.AddPair('user', LArray);
    for var LName in FUserFiles do
      LArray.Add(LName);

    LArray := TJSONArray.Create;
    LRoot.AddPair('operations', LArray);
    for var LName in FOperations do
      LArray.Add(LName);

    TFile.WriteAllText(AFileName, LRoot.Format(2), TEncoding.UTF8);
  finally
    LRoot.Free;
  end;
end;

{ TGenOutput }

constructor TGenOutput.Create(const AFolder, AName: string; const AForce: Boolean);
begin
  inherited Create;
  FFolder := AFolder;
  FForce := AForce;
  FManifestFile := ManifestFileName(AFolder, AName);
  FPrevious := LoadManifest(AFolder, AName);
  FCurrent := TGenManifest.Create;
  ForceDirectories(FFolder);
end;

destructor TGenOutput.Destroy;
begin
  FCurrent.Free;
  FPrevious.Free;
  inherited;
end;

class function TGenOutput.HashOf(const AFileName: string): string;
begin
  Result := THashSHA2.GetHashString(TFile.ReadAllText(AFileName, TEncoding.UTF8));
end;

class function TGenOutput.ApiName(const AApi: TGenApi): string;
begin
  Result := TGenNaming.Sanitize(TGenNaming.PascalCase(AApi.Title));
  if Result = '_' then
    Result := 'Api';
end;

class function TGenOutput.ManifestFileName(const AFolder, AName: string): string;
begin
  Result := TPath.Combine(AFolder, AName + MANIFEST_EXTENSION);
end;

class function TGenOutput.LoadManifest(const AFolder, AName: string): TGenManifest;
var
  LFile: string;
begin
  Result := nil;
  LFile := ManifestFileName(AFolder, AName);
  if not TFile.Exists(LFile) then
    Exit;
  Result := TGenManifest.Create;
  try
    Result.LoadFromFile(LFile);
  except
    FreeAndNil(Result);
    raise;
  end;
end;

procedure TGenOutput.WriteGenerated(const AFileName, AContent: string);
var
  LFile, LHash: string;
begin
  LFile := TPath.Combine(FFolder, AFileName);
  if TFile.Exists(LFile) and not FForce then
  begin
    // ours, as written last time: written again; changed since, or not ours: kept
    if not (Assigned(FPrevious) and FPrevious.Generated.TryGetValue(AFileName, LHash)) then
    begin
      FForeign := FForeign + [LFile];
      Exit;
    end;
    if not SameText(LHash, HashOf(LFile)) then
    begin
      FChanged := FChanged + [LFile];
      // still generated by MARSgen: its hash stays the one of the last import
      FCurrent.Generated.AddOrSetValue(AFileName, LHash);
      Exit;
    end;
  end;

  TFile.WriteAllText(LFile, AContent, TEncoding.UTF8);
  FWritten := FWritten + [LFile];
  FCurrent.Generated.AddOrSetValue(AFileName, HashOf(LFile));
end;

procedure TGenOutput.WriteUser(const AFileName, AContent: string);
var
  LFile: string;
begin
  LFile := TPath.Combine(FFolder, AFileName);
  if TFile.Exists(LFile) then
    FKept := FKept + [LFile]
  else
  begin
    TFile.WriteAllText(LFile, AContent, TEncoding.UTF8);
    FCreated := FCreated + [LFile];
  end;
  if not FCurrent.UserFiles.Contains(AFileName) then
    FCurrent.UserFiles.Add(AFileName);
end;

procedure TGenOutput.Finish(const AApi: TGenApi; const AMode, ADocument, ADocumentHash: string;
  const AOptions: TGenTypeOptions);
var
  LOperation: string;
begin
  FCurrent.Document := ADocument;
  FCurrent.DocumentHash := ADocumentHash;
  FCurrent.Mode := AMode;
  FCurrent.Options := AOptions;
  FCurrent.ImportedAt := DateToISO8601(Now, False);
  for var LItem in AApi.Operations do
  begin
    LOperation := UpperCase(LItem.Method) + ' ' + LItem.Path;
    if not FCurrent.Operations.Contains(LOperation) then
      FCurrent.Operations.Add(LOperation);
  end;

  if Assigned(FPrevious) then
  begin
    for var LItem in FCurrent.Operations do
      if not FPrevious.Operations.Contains(LItem) then
        FAdded := FAdded + [LItem];
    for var LItem in FPrevious.Operations do
      if not FCurrent.Operations.Contains(LItem) then
        FRemoved := FRemoved + [LItem];
    // generated last time, not now: left on disk, reported (again next time, while it exists)
    for var LPair in FPrevious.Generated do
      if not FCurrent.Generated.ContainsKey(LPair.Key) and TFile.Exists(TPath.Combine(FFolder, LPair.Key)) then
      begin
        FStale := FStale + [TPath.Combine(FFolder, LPair.Key)];
        FCurrent.Generated.Add(LPair.Key, LPair.Value);
      end;
    // the files of the user not used now stay in the manifest while they exist
    for var LName in FPrevious.UserFiles do
      if not FCurrent.UserFiles.Contains(LName) and TFile.Exists(TPath.Combine(FFolder, LName)) then
      begin
        FUnused := FUnused + [TPath.Combine(FFolder, LName)];
        FCurrent.UserFiles.Add(LName);
      end;
  end;

  FCurrent.SaveToFile(FManifestFile);
end;

end.
