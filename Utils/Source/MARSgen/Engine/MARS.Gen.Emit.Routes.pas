unit MARS.Gen.Emit.Routes;

// Writes a MARS server as routes (MARS.Core.Routes) instead of resource classes, from the same
// mapping (TGenServerMapper: one module per first segment of the paths):
// - Server.Routes.<Name>.Base: generated, written again on every import. A base class with a
//   protected virtual Do method per operation (501 Not Implemented until overridden), and the class
//   function Routes(AClass): the definition of the routes, with every declaration (name, media
//   types, roles, parameters), each request handled by a new instance of AClass;
// - Server.Routes.<Name>: the code of the user, created only when missing. A subclass with the
//   overrides, registered with MARSRoutes;
// - Server.<Api>: generated, uses the units of the user (with AddRoutes('Server.Routes.*') in the
//   ignition).

interface

uses
  System.SysUtils, System.Classes,
  MARS.Gen.Model, MARS.Gen.Types, MARS.Gen.Server, MARS.Gen.Output;

type
  TGenRoutesEmitter = class
  private
    FServer: TGenServerMapper;
    FLines: TStringList;
    procedure Add(const ALine: string = '');
    procedure AddComments(const AComments: TArray<string>; const AIndent: string);
    procedure AddHeader(const AGenerated: Boolean);
    function Signature(const AEndpoint: TGenEndpoint; const AClassName: string): string;
    function Arguments(const AEndpoint: TGenEndpoint): string;
    function RoutePath(const AEndpoint: TGenEndpoint): string;
    function ReadParam(const AParam: TGenEndpointParam): string;
    procedure AddRoute(const AResource: TGenResource; const AEndpoint: TGenEndpoint);
    function SystemUnits: string;
  public
    constructor Create(const AServer: TGenServerMapper);
    destructor Destroy; override;

    class function BaseUnitName(const AResource: TGenResource): string; static;
    class function UserUnitName(const AResource: TGenResource): string; static;
    class function BaseClass(const AResource: TGenResource): string; static;
    class function UserClass(const AResource: TGenResource): string; static;
    // class of the base: T<Name>RoutesClass
    class function ClassReference(const AResource: TGenResource): string; static;

    function BaseUnit(const AResource: TGenResource): string;
    function UserUnit(const AResource: TGenResource): string;
    function ApiUnit: string;

    // the routes units through AOutput, the types mapped (and written) by the caller; returns
    // the name of the unit Server.<Api>
    class function WriteTo(const AApi: TGenApi; const ATypes: TGenTypeMapper; const AOutput: TGenOutput): string; static;
  end;

implementation

uses
  System.StrUtils,
  MARS.Gen.Naming;

const
  INDENT = '  ';
  WRAP_WIDTH = 100;

function Quoted(const AText: string): string;
begin
  Result := '''' + AText.Replace('''', '''''') + '''';
end;

{ TGenRoutesEmitter }

constructor TGenRoutesEmitter.Create(const AServer: TGenServerMapper);
begin
  inherited Create;
  FServer := AServer;
  FLines := TStringList.Create;
end;

destructor TGenRoutesEmitter.Destroy;
begin
  FLines.Free;
  inherited;
end;

class function TGenRoutesEmitter.UserUnitName(const AResource: TGenResource): string;
begin
  Result := 'Server.Routes.' + AResource.Name;
end;

class function TGenRoutesEmitter.BaseUnitName(const AResource: TGenResource): string;
begin
  Result := UserUnitName(AResource) + '.Base';
end;

class function TGenRoutesEmitter.UserClass(const AResource: TGenResource): string;
begin
  Result := 'T' + AResource.Name + 'Routes';
end;

class function TGenRoutesEmitter.ClassReference(const AResource: TGenResource): string;
begin
  Result := UserClass(AResource) + 'Class';
end;

class function TGenRoutesEmitter.BaseClass(const AResource: TGenResource): string;
begin
  Result := UserClass(AResource) + 'Base';
end;

procedure TGenRoutesEmitter.Add(const ALine: string);
begin
  FLines.Add(ALine);
end;

procedure TGenRoutesEmitter.AddComments(const AComments: TArray<string>; const AIndent: string);
begin
  for var LLine in AComments do
    if LLine.Trim = '' then
      Add(AIndent + '//')
    else
      for var LWrapped in TGenNaming.WrapWords(LLine, WRAP_WIDTH) do
        Add(AIndent + '// ' + LWrapped);
end;

procedure TGenRoutesEmitter.AddHeader(const AGenerated: Boolean);
var
  LApi: TGenApi;
  LSource: string;
begin
  LApi := FServer.Api;
  LSource := '"' + LApi.Title + '"';
  if LApi.Version <> '' then
    LSource := LSource + ' ' + LApi.Version;
  if LApi.OpenAPIVersion <> '' then
    LSource := LSource + ' (OpenAPI ' + LApi.OpenAPIVersion + ')';

  Add('(*');
  if AGenerated then
  begin
    Add('  Generated by MARSgen from ' + LSource + '.');
    Add('  Do not edit: this unit is written again when the document is imported again.');
  end
  else
  begin
    Add('  Created by MARSgen from ' + LSource + ', then yours: MARSgen does not write it again.');
    Add('  Override the Do methods of the base class: the ones you do not override answer');
    Add('  501 Not Implemented.');
  end;
  Add('*)');
end;

function TGenRoutesEmitter.SystemUnits: string;
begin
  Result := '';
  if FServer.Types.Options.Classes then
    Result := ', System.Generics.Collections';
end;

function TGenRoutesEmitter.Signature(const AEndpoint: TGenEndpoint; const AClassName: string): string;
var
  LParams: TArray<string>;
begin
  LParams := [];
  for var LItem in AEndpoint.Params do
    LParams := LParams + ['const ' + LItem.Name + ': ' + LItem.TypeName];
  if AEndpoint.ResultType = '' then
    Result := 'procedure '
  else
    Result := 'function ';
  if AClassName <> '' then
    Result := Result + AClassName + '.';
  Result := Result + AEndpoint.ImplementationName;
  if Length(LParams) > 0 then
    Result := Result + '(' + string.Join('; ', LParams) + ')';
  if AEndpoint.ResultType <> '' then
    Result := Result + ': ' + AEndpoint.ResultType;
  Result := Result + ';';
end;

function TGenRoutesEmitter.Arguments(const AEndpoint: TGenEndpoint): string;
var
  LNames: TArray<string>;
begin
  LNames := [];
  for var LParam in AEndpoint.Params do
    LNames := LNames + [LParam.Name];
  Result := string.Join(', ', LNames);
end;

function TGenRoutesEmitter.RoutePath(const AEndpoint: TGenEndpoint): string;
var
  LSegments: TArray<string>;
  LParam: TGenEndpointParam;
begin
  // the integer parameters constrained: {petId:int} (typed in the OpenAPI document, 404 otherwise)
  LSegments := AEndpoint.RelativePath.Split(['/']);
  for var LIndex := 0 to High(LSegments) do
    if LSegments[LIndex].StartsWith('{') then
    begin
      LParam := AEndpoint.ParamOf(LSegments[LIndex].Substring(1, Length(LSegments[LIndex]) - 2));
      if Assigned(LParam) and ((LParam.TypeName = 'Integer') or (LParam.TypeName = 'Int64')) then
        LSegments[LIndex] := '{' + LParam.ExternalName + ':int}';
    end;
  Result := string.Join('/', LSegments);
end;

function TGenRoutesEmitter.ReadParam(const AParam: TGenEndpointParam): string;
const
  READERS: array[TGenEndpointParamKind] of string = ('Path', 'Query', 'Header', 'Cookie', '');
var
  LDefault: string;
begin
  if AParam.Kind = TGenEndpointParamKind.Path then
    Exit('C.Path<' + AParam.TypeName + '>(' + Quoted(AParam.ExternalName) + ')');

  // missing: the empty value of the type (the required ones are checked before: 400)
  if AParam.TypeName = 'string' then
    LDefault := ''''''
  else if AParam.TypeName = 'Boolean' then
    LDefault := 'False'
  else
    LDefault := '0';
  Result := 'C.' + READERS[AParam.Kind] + '<' + AParam.TypeName + '>(' + Quoted(AParam.ExternalName) + ', ' + LDefault + ')';
end;

procedure TGenRoutesEmitter.AddRoute(const AResource: TGenResource; const AEndpoint: TGenEndpoint);
const
  DECLARATIONS: array[TGenEndpointParamKind] of string = ('', 'QueryParam', 'HeaderParam', 'CookieParam', '');
var
  LBody: TGenEndpointParam;
  LMap, LHandler, LCall, LIndent: string;
  LArguments: TArray<string>;
  LDeclarations: TArray<string>;
begin
  LBody := AEndpoint.BodyParam;
  LIndent := INDENT + INDENT + INDENT;

  // Map<TResult>, Map<TBody, TResult>, MapBody<TBody>, Map: any method (QUERY too)
  if (AEndpoint.ResultType <> '') and Assigned(LBody) then
  begin
    LMap := 'Map<' + LBody.TypeName + ', ' + AEndpoint.ResultType + '>';
    LHandler := 'function (const C: TMARSRouteContext; const ABody: ' + LBody.TypeName + '): ' + AEndpoint.ResultType;
  end
  else if AEndpoint.ResultType <> '' then
  begin
    LMap := 'Map<' + AEndpoint.ResultType + '>';
    LHandler := 'function (const C: TMARSRouteContext): ' + AEndpoint.ResultType;
  end
  else if Assigned(LBody) then
  begin
    LMap := 'MapBody<' + LBody.TypeName + '>';
    LHandler := 'procedure (const C: TMARSRouteContext; const ABody: ' + LBody.TypeName + ')';
  end
  else
  begin
    LMap := 'Map';
    LHandler := 'procedure (const C: TMARSRouteContext)';
  end;

  // the arguments of the Do method, in its order
  LArguments := [];
  for var LParam in AEndpoint.Params do
    if LParam.Kind = TGenEndpointParamKind.Body then
      LArguments := LArguments + ['ABody']
    else
      LArguments := LArguments + [ReadParam(LParam)];
  LCall := 'LHandler.' + AEndpoint.ImplementationName;
  if Length(LArguments) > 0 then
    LCall := LCall + '(' + string.Join(', ', LArguments) + ')';

  AddComments(AEndpoint.Comments, LIndent);
  Add(LIndent + 'R.' + LMap + '(' + Quoted(AEndpoint.HttpMethod) + ', ' + Quoted(RoutePath(AEndpoint)) + ',');
  Add(LIndent + INDENT + LHandler);
  Add(LIndent + INDENT + 'var');
  Add(LIndent + INDENT + INDENT + 'LHandler: ' + BaseClass(AResource) + ';');
  Add(LIndent + INDENT + 'begin');
  Add(LIndent + INDENT + INDENT + 'LHandler := AClass.Create(C);');
  Add(LIndent + INDENT + INDENT + 'try');
  if AEndpoint.ResultType = '' then
    Add(LIndent + INDENT + INDENT + INDENT + LCall + ';')
  else
    Add(LIndent + INDENT + INDENT + INDENT + 'Result := ' + LCall + ';');
  Add(LIndent + INDENT + INDENT + 'finally');
  Add(LIndent + INDENT + INDENT + INDENT + 'LHandler.Free;');
  Add(LIndent + INDENT + INDENT + 'end;');
  if AEndpoint.StatusCode <> 0 then
    Add(LIndent + INDENT + INDENT + 'C.Status(' + AEndpoint.StatusCode.ToString + ');');
  Add(LIndent + INDENT + 'end');

  // the declarations: the operation, its media types, security and parameters (OpenAPI)
  LDeclarations := [];
  if AEndpoint.Operation.OperationId <> '' then
    LDeclarations := LDeclarations + ['Name(' + Quoted(AEndpoint.Operation.OperationId) + ')'];
  if AEndpoint.Operation.Summary <> '' then
    LDeclarations := LDeclarations + ['Summary(' + Quoted(AEndpoint.Operation.Summary.Replace(#13, ' ').Replace(#10, ' ').Trim) + ')'];
  if AEndpoint.Produces <> '' then
    LDeclarations := LDeclarations + ['Produces(' + Quoted(AEndpoint.Produces) + ')'];
  if AEndpoint.Consumes <> '' then
    LDeclarations := LDeclarations + ['Consumes(' + Quoted(AEndpoint.Consumes) + ')'];
  // an optional body (routes describe it as required by default)
  if Assigned(LBody) and not LBody.Required then
    LDeclarations := LDeclarations + ['BodyRequired(False)'];
  case AEndpoint.Authorization of
    TGenAuthorization.PermitAll:
      LDeclarations := LDeclarations + ['PermitAll'];
    TGenAuthorization.Authenticated:
      LDeclarations := LDeclarations + ['Authenticated'];
    TGenAuthorization.Roles:
      LDeclarations := LDeclarations + ['RolesAllowed(' + Quoted(string.Join(',', AEndpoint.Roles)) + ')'];
  end;
  for var LParam in AEndpoint.Params do
    if DECLARATIONS[LParam.Kind] <> '' then
      LDeclarations := LDeclarations + [DECLARATIONS[LParam.Kind] + '<' + LParam.TypeName + '>(' + Quoted(LParam.ExternalName)
        + ', ' + Quoted(string.Join('; ', LParam.Comments).Replace(#13, ' ').Replace(#10, ' ')) + ', '
        + IfThen(LParam.Required, 'True', 'False') + ')'];

  if Length(LDeclarations) = 0 then
    Add(LIndent + ');')
  else
  begin
    Add(LIndent + ').' + LDeclarations[0]);
    for var LIndex := 1 to High(LDeclarations) do
      Add(LIndent + ' .' + LDeclarations[LIndex]);
    FLines[FLines.Count - 1] := FLines[FLines.Count - 1] + ';';
  end;
  Add;
end;

function TGenRoutesEmitter.BaseUnit(const AResource: TGenResource): string;
begin
  FLines.Clear;
  AddHeader(True);
  Add('unit ' + BaseUnitName(AResource) + ';');
  Add;
  Add('interface');
  Add;
  Add('uses');
  Add(INDENT + 'System.SysUtils, System.Classes, System.JSON' + SystemUnits);
  Add(', MARS.Core.Routes, MARS.Core.JSON');
  Add(', ' + FServer.Types.UnitName);
  Add(';');
  Add;
  Add('type');
  Add(INDENT + BaseClass(AResource) + ' = class;');
  Add(INDENT + ClassReference(AResource) + ' = class of ' + BaseClass(AResource) + ';');
  Add;
  AddComments(AResource.Comments, INDENT);
  Add(INDENT + '// the routes of /' + AResource.Segment + ': a new instance of the class given to Routes per request');
  Add(INDENT + BaseClass(AResource) + ' = class');
  Add(INDENT + 'private');
  Add(INDENT + INDENT + 'FContext: TMARSRouteContext;');
  Add(INDENT + 'protected');
  Add(INDENT + INDENT + '// the implementations: override them (by default: 501 Not Implemented)');
  for var LEndpoint in AResource.Endpoints do
  begin
    AddComments(LEndpoint.Comments, INDENT + INDENT);
    for var LParam in LEndpoint.Params do
      if Length(LParam.Comments) > 0 then
        AddComments([LParam.Name + ': ' + string.Join('; ', LParam.Comments)], INDENT + INDENT);
    Add(INDENT + INDENT + Signature(LEndpoint, '').TrimRight([';']) + '; virtual;');
  end;
  Add;
  Add(INDENT + INDENT + '// the request: the token, the request and the response, injection (Context.Inject<T>)...');
  Add(INDENT + INDENT + 'property Context: TMARSRouteContext read FContext;');
  Add(INDENT + 'public');
  Add(INDENT + INDENT + 'constructor Create(const AContext: TMARSRouteContext); virtual;');
  Add(INDENT + INDENT + '// the definition of the routes (MARSRoutes), handled by instances of AClass');
  Add(INDENT + INDENT + 'class function Routes(const AClass: ' + ClassReference(AResource)
    + '): TMARSRouteDefineProc;');
  Add(INDENT + 'end;');
  Add;
  Add('implementation');
  Add;
  Add('uses');
  Add(INDENT + 'MARS.Core.Exceptions;');
  Add;
  Add('{ ' + BaseClass(AResource) + ' }');
  Add;
  Add('constructor ' + BaseClass(AResource) + '.Create(const AContext: TMARSRouteContext);');
  Add('begin');
  Add(INDENT + 'inherited Create;');
  Add(INDENT + 'FContext := AContext;');
  Add('end;');
  for var LEndpoint in AResource.Endpoints do
  begin
    Add;
    Add(Signature(LEndpoint, BaseClass(AResource)));
    Add('begin');
    Add(INDENT + 'raise EMARSHttpException.Create('
      + Quoted('Not implemented: ' + LEndpoint.HttpMethod + ' ' + LEndpoint.Operation.Path) + ', 501);');
    Add('end;');
  end;
  Add;
  Add('class function ' + BaseClass(AResource) + '.Routes(const AClass: ' + ClassReference(AResource)
    + '): TMARSRouteDefineProc;');
  Add('begin');
  Add(INDENT + 'Result :=');
  Add(INDENT + INDENT + 'procedure (const R: TMARSRouter)');
  Add(INDENT + INDENT + 'begin');
  for var LEndpoint in AResource.Endpoints do
    AddRoute(AResource, LEndpoint);
  FLines.Delete(FLines.Count - 1);
  Add(INDENT + INDENT + 'end;');
  Add('end;');
  Add;
  Add('end.');
  Result := FLines.Text;
end;

function TGenRoutesEmitter.UserUnit(const AResource: TGenResource): string;
var
  LCall: string;
begin
  FLines.Clear;
  AddHeader(False);
  Add('unit ' + UserUnitName(AResource) + ';');
  Add;
  Add('interface');
  Add;
  Add('uses');
  Add(INDENT + 'System.SysUtils, System.Classes, System.JSON' + SystemUnits);
  Add(', MARS.Core.Routes, MARS.Core.JSON');
  Add(', ' + FServer.Types.UnitName + ', ' + BaseUnitName(AResource));
  Add(';');
  Add;
  Add('type');
  Add(INDENT + '// a new instance per request: Context is the request (token, headers, injection...)');
  Add(INDENT + UserClass(AResource) + ' = class(' + BaseClass(AResource) + ')');
  Add(INDENT + 'protected');
  for var LEndpoint in AResource.Endpoints do
    Add(INDENT + INDENT + Signature(LEndpoint, '').TrimRight([';']) + '; override;');
  Add(INDENT + 'end;');
  Add;
  Add('implementation');
  Add;
  Add('{ ' + UserClass(AResource) + ' }');
  for var LEndpoint in AResource.Endpoints do
  begin
    Add;
    Add(Signature(LEndpoint, UserClass(AResource)));
    Add('begin');
    Add(INDENT + '// TODO: ' + LEndpoint.HttpMethod + ' ' + LEndpoint.Operation.Path);
    LCall := 'inherited ' + LEndpoint.ImplementationName;
    if LEndpoint.Params.Count > 0 then
      LCall := LCall + '(' + Arguments(LEndpoint) + ')';
    if LEndpoint.ResultType = '' then
      Add(INDENT + LCall + ';')
    else
      Add(INDENT + 'Result := ' + LCall + ';');
    Add('end;');
  end;
  Add;
  Add('initialization');
  Add(INDENT + 'MARSRoutes(' + Quoted(UserUnitName(AResource)) + ', ' + Quoted(AResource.Segment) + ', '
    + BaseClass(AResource) + '.Routes(' + UserClass(AResource) + '));');
  Add;
  Add('end.');
  Result := FLines.Text;
end;

function TGenRoutesEmitter.ApiUnit: string;
var
  LUnits: TArray<string>;
begin
  FLines.Clear;
  AddHeader(True);
  Add('unit ' + FServer.ApiUnitName + ';');
  Add;
  Add('// The routes of the API: add this unit to the uses of Server.Ignition, whose application adds');
  Add('// the Server.Routes.* modules (LApplication.AddRoutes(''Server.Routes.*'')).');
  Add;
  Add('interface');
  Add;
  LUnits := [];
  for var LResource in FServer.Resources do
    LUnits := LUnits + [UserUnitName(LResource)];
  if Length(LUnits) > 0 then
  begin
    Add('uses');
    Add(INDENT + string.Join(sLineBreak + ', ', LUnits));
    Add(';');
    Add;
  end;
  Add('implementation');
  Add;
  Add('end.');
  Result := FLines.Text;
end;

class function TGenRoutesEmitter.WriteTo(const AApi: TGenApi; const ATypes: TGenTypeMapper;
  const AOutput: TGenOutput): string;
var
  LServer: TGenServerMapper;
  LEmitter: TGenRoutesEmitter;
begin
  LServer := TGenServerMapper.Create(AApi, ATypes);
  try
    LServer.Execute;
    LEmitter := TGenRoutesEmitter.Create(LServer);
    try
      for var LResource in LServer.Resources do
      begin
        AOutput.WriteGenerated(BaseUnitName(LResource) + '.pas', LEmitter.BaseUnit(LResource));
        // the code of the user: never written again
        AOutput.WriteUser(UserUnitName(LResource) + '.pas', LEmitter.UserUnit(LResource), BaseUnitName(LResource));
      end;
      AOutput.WriteGenerated(LServer.ApiUnitName + '.pas', LEmitter.ApiUnit);
      Result := LServer.ApiUnitName;
    finally
      LEmitter.Free;
    end;
  finally
    LServer.Free;
  end;
end;

end.
