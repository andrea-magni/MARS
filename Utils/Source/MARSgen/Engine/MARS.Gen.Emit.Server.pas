unit MARS.Gen.Emit.Server;

// Writes the units of a MARS server (TGenServerMapper):
// - Server.Resources.<Name>.Base: generated, written again on every import. A base class per
//   resource, with every attribute; per operation a public method (the endpoint) that calls a
//   protected virtual one (Do...), answering 501 Not Implemented until overridden;
// - Server.Resources.<Name>: the code of the user, created only when missing. A subclass of the
//   base class with the overrides, registered with MARSRegister;
// - Server.<Api>: generated, uses the units of the user (one line in the ignition links them).

interface

uses
  System.SysUtils, System.Classes,
  MARS.Gen.Model, MARS.Gen.Types, MARS.Gen.Server;

type
  TGenServerFiles = record
    // written (generated), created (of the user, new), kept (of the user, already there)
    Written: TArray<string>;
    Created: TArray<string>;
    Kept: TArray<string>;
  end;

  TGenServerEmitter = class
  private
    FServer: TGenServerMapper;
    FLines: TStringList;
    procedure Add(const ALine: string = '');
    procedure AddComments(const AComments: TArray<string>; const AIndent: string);
    procedure AddHeader(const AGenerated: Boolean);
    function Signature(const AEndpoint: TGenEndpoint; const AClassName, AMethodName: string;
      const AWithAttributes: Boolean): string;
    function Arguments(const AEndpoint: TGenEndpoint): string;
    function Attributes(const AEndpoint: TGenEndpoint): string;
    function UsesTypes: string;
  public
    constructor Create(const AServer: TGenServerMapper);
    destructor Destroy; override;

    function BaseUnit(const AResource: TGenResource): string;
    function UserUnit(const AResource: TGenResource): string;
    function ApiUnit: string;

    // the types (Model.<Api>) and the server units into AFolder; units of the user only when missing
    class function WriteServer(const AApi: TGenApi; const AOptions: TGenTypeOptions;
      const AFolder: string): TGenServerFiles; static;
  end;

implementation

uses
  System.IOUtils, System.StrUtils,
  MARS.Gen.Naming, MARS.Gen.Emit.Types;

const
  INDENT = '  ';
  WRAP_WIDTH = 100;

function Quoted(const AText: string): string;
begin
  Result := '''' + AText.Replace('''', '''''') + '''';
end;

{ TGenServerEmitter }

constructor TGenServerEmitter.Create(const AServer: TGenServerMapper);
begin
  inherited Create;
  FServer := AServer;
  FLines := TStringList.Create;
end;

destructor TGenServerEmitter.Destroy;
begin
  FLines.Free;
  inherited;
end;

procedure TGenServerEmitter.Add(const ALine: string);
begin
  FLines.Add(ALine);
end;

procedure TGenServerEmitter.AddComments(const AComments: TArray<string>; const AIndent: string);
begin
  for var LLine in AComments do
    if LLine.Trim = '' then
      Add(AIndent + '//')
    else
      for var LWrapped in TGenNaming.WrapWords(LLine, WRAP_WIDTH) do
        Add(AIndent + '// ' + LWrapped);
end;

procedure TGenServerEmitter.AddHeader(const AGenerated: Boolean);
var
  LApi: TGenApi;
  LSource: string;
begin
  LApi := FServer.Api;
  LSource := '"' + LApi.Title + '"';
  if LApi.Version <> '' then
    LSource := LSource + ' ' + LApi.Version;
  if LApi.OpenAPIVersion <> '' then
    LSource := LSource + ' (OpenAPI ' + LApi.OpenAPIVersion + ')';

  Add('(*');
  if AGenerated then
  begin
    Add('  Generated by MARSgen from ' + LSource + '.');
    Add('  Do not edit: this unit is written again when the document is imported again.');
  end
  else
  begin
    Add('  Created by MARSgen from ' + LSource + ', then yours: MARSgen does not write it again.');
    Add('  Override the Do methods of the base class: the ones you do not override answer');
    Add('  501 Not Implemented.');
  end;
  Add('*)');
end;

function TGenServerEmitter.UsesTypes: string;
begin
  Result := FServer.Types.UnitName;
end;

function TGenServerEmitter.Arguments(const AEndpoint: TGenEndpoint): string;
var
  LNames: TArray<string>;
begin
  LNames := [];
  for var LParam in AEndpoint.Params do
    LNames := LNames + [LParam.Name];
  Result := string.Join(', ', LNames);
end;

function TGenServerEmitter.Signature(const AEndpoint: TGenEndpoint; const AClassName, AMethodName: string;
  const AWithAttributes: Boolean): string;
const
  BINDINGS: array[TGenEndpointParamKind] of string = ('PathParam', 'QueryParam', 'HeaderParam', 'CookieParam', 'BodyParam');
var
  LParams: TArray<string>;
  LParam, LAttributes: string;
begin
  LParams := [];
  for var LItem in AEndpoint.Params do
  begin
    LParam := '';
    if AWithAttributes then
    begin
      if LItem.Kind = TGenEndpointParamKind.Body then
        LAttributes := BINDINGS[LItem.Kind]
      else
        LAttributes := BINDINGS[LItem.Kind] + '(' + Quoted(LItem.ExternalName) + ')';
      // path parameters are always there
      if LItem.Required and (LItem.Kind <> TGenEndpointParamKind.Path) then
        LAttributes := LAttributes + ', Required';
      LParam := '[' + LAttributes + '] ';
    end;
    LParams := LParams + [LParam + 'const ' + LItem.Name + ': ' + LItem.TypeName];
  end;

  if AEndpoint.ResultType = '' then
    Result := 'procedure '
  else
    Result := 'function ';
  if AClassName <> '' then
    Result := Result + AClassName + '.';
  Result := Result + AMethodName;
  if Length(LParams) > 0 then
    Result := Result + '(' + string.Join('; ', LParams) + ')';
  if AEndpoint.ResultType <> '' then
    Result := Result + ': ' + AEndpoint.ResultType;
  Result := Result + ';';
end;

function TGenServerEmitter.Attributes(const AEndpoint: TGenEndpoint): string;
var
  LItems: TArray<string>;
begin
  LItems := [AEndpoint.HttpMethod];
  if AEndpoint.RelativePath <> '' then
    LItems := LItems + ['Path(' + Quoted(AEndpoint.RelativePath) + ')'];
  if AEndpoint.Produces <> '' then
    LItems := LItems + ['Produces(' + Quoted(AEndpoint.Produces) + ')'];
  if AEndpoint.Consumes <> '' then
    LItems := LItems + ['Consumes(' + Quoted(AEndpoint.Consumes) + ')'];
  case AEndpoint.Authorization of
    TGenAuthorization.PermitAll:
      LItems := LItems + ['PermitAll'];
    TGenAuthorization.Roles:
      LItems := LItems + ['RolesAllowed(' + Quoted(string.Join(',', AEndpoint.Roles)) + ')'];
  end;
  Result := '[' + string.Join(', ', LItems) + ']';
end;

function TGenServerEmitter.BaseUnit(const AResource: TGenResource): string;
var
  LAuthenticated: Boolean;
  LCall: string;
begin
  LAuthenticated := False;
  for var LEndpoint in AResource.Endpoints do
    if LEndpoint.Authorization = TGenAuthorization.Authenticated then
      LAuthenticated := True;

  FLines.Clear;
  AddHeader(True);
  Add('unit ' + AResource.BaseUnit + ';');
  Add;
  Add('interface');
  Add;
  Add('uses');
  Add(INDENT + 'System.SysUtils, System.Classes, System.JSON');
  Add(', MARS.Core.Attributes, MARS.Core.JSON, MARS.Core.Token, MARS.Core.RequestAndResponse.Interfaces');
  Add(', ' + UsesTypes);
  Add(';');
  Add;
  Add('type');
  AddComments(AResource.Comments, INDENT);
  Add(INDENT + '[Path(' + Quoted(IfThen(AResource.Segment = '', '/', AResource.Segment)) + ')]');
  Add(INDENT + AResource.BaseClass + ' = class');
  Add(INDENT + 'protected');
  Add(INDENT + INDENT + '[Context] FToken: TMARSToken;');
  Add(INDENT + INDENT + '[Context] FResponse: IMARSResponse;');
  if LAuthenticated then
    Add(INDENT + INDENT + 'procedure CheckAuthenticated; virtual;');
  Add;
  Add(INDENT + INDENT + '// the implementations: override them (by default: 501 Not Implemented)');
  for var LEndpoint in AResource.Endpoints do
    Add(INDENT + INDENT + Signature(LEndpoint, '', LEndpoint.ImplementationName, False).TrimRight([';']) + '; virtual;');
  Add(INDENT + 'public');
  for var LEndpoint in AResource.Endpoints do
  begin
    AddComments(LEndpoint.Comments, INDENT + INDENT);
    for var LParam in LEndpoint.Params do
      if Length(LParam.Comments) > 0 then
        AddComments([LParam.Name + ': ' + string.Join('; ', LParam.Comments)], INDENT + INDENT);
    Add(INDENT + INDENT + Attributes(LEndpoint));
    Add(INDENT + INDENT + Signature(LEndpoint, '', LEndpoint.EndpointName, True));
  end;
  Add(INDENT + 'end;');
  Add;
  Add('implementation');
  Add;
  Add('uses');
  Add(INDENT + 'MARS.Core.Exceptions;');
  Add;
  Add('{ ' + AResource.BaseClass + ' }');

  if LAuthenticated then
  begin
    Add;
    Add('procedure ' + AResource.BaseClass + '.CheckAuthenticated;');
    Add('begin');
    Add(INDENT + 'if not (Assigned(FToken) and FToken.IsVerified and not FToken.IsExpired) then');
    Add(INDENT + INDENT + 'raise EMARSAuthenticationException.Create(''Unauthorized'', 401);');
    Add('end;');
  end;

  for var LEndpoint in AResource.Endpoints do
  begin
    Add;
    Add(Signature(LEndpoint, AResource.BaseClass, LEndpoint.ImplementationName, False));
    Add('begin');
    Add(INDENT + 'raise EMARSHttpException.Create('
      + Quoted('Not implemented: ' + LEndpoint.HttpMethod + ' ' + LEndpoint.Operation.Path) + ', 501);');
    Add('end;');
  end;

  for var LEndpoint in AResource.Endpoints do
  begin
    Add;
    Add(Signature(LEndpoint, AResource.BaseClass, LEndpoint.EndpointName, False));
    Add('begin');
    if LEndpoint.Authorization = TGenAuthorization.Authenticated then
      Add(INDENT + 'CheckAuthenticated;');
    LCall := LEndpoint.ImplementationName;
    if LEndpoint.Params.Count > 0 then
      LCall := LCall + '(' + Arguments(LEndpoint) + ')';
    if LEndpoint.ResultType = '' then
      Add(INDENT + LCall + ';')
    else
      Add(INDENT + 'Result := ' + LCall + ';');
    if LEndpoint.StatusCode <> 0 then
      Add(INDENT + 'FResponse.StatusCode := ' + LEndpoint.StatusCode.ToString + ';');
    Add('end;');
  end;

  Add;
  Add('end.');
  Result := FLines.Text;
end;

function TGenServerEmitter.UserUnit(const AResource: TGenResource): string;
var
  LCall: string;
begin
  FLines.Clear;
  AddHeader(False);
  Add('unit ' + AResource.ResourceUnit + ';');
  Add;
  Add('interface');
  Add;
  Add('uses');
  Add(INDENT + 'System.SysUtils, System.Classes, System.JSON');
  Add(', MARS.Core.Registry, MARS.Core.JSON');
  Add(', ' + UsesTypes + ', ' + AResource.BaseUnit);
  Add(';');
  Add;
  Add('type');
  Add(INDENT + AResource.ResourceClass + ' = class(' + AResource.BaseClass + ')');
  Add(INDENT + 'protected');
  for var LEndpoint in AResource.Endpoints do
    Add(INDENT + INDENT + Signature(LEndpoint, '', LEndpoint.ImplementationName, False).TrimRight([';']) + '; override;');
  Add(INDENT + 'end;');
  Add;
  Add('implementation');
  Add;
  Add('{ ' + AResource.ResourceClass + ' }');
  for var LEndpoint in AResource.Endpoints do
  begin
    Add;
    Add(Signature(LEndpoint, AResource.ResourceClass, LEndpoint.ImplementationName, False));
    Add('begin');
    Add(INDENT + '// TODO: ' + LEndpoint.HttpMethod + ' ' + LEndpoint.Operation.Path);
    LCall := 'inherited ' + LEndpoint.ImplementationName;
    if LEndpoint.Params.Count > 0 then
      LCall := LCall + '(' + Arguments(LEndpoint) + ')';
    if LEndpoint.ResultType = '' then
      Add(INDENT + LCall + ';')
    else
      Add(INDENT + 'Result := ' + LCall + ';');
    Add('end;');
  end;
  Add;
  Add('initialization');
  Add(INDENT + 'MARSRegister(' + AResource.ResourceClass + ');');
  Add;
  Add('end.');
  Result := FLines.Text;
end;

function TGenServerEmitter.ApiUnit: string;
var
  LUnits: TArray<string>;
begin
  FLines.Clear;
  AddHeader(True);
  Add('unit ' + FServer.ApiUnitName + ';');
  Add;
  Add('// The resources of the API: add this unit to the uses of Server.Ignition, whose application');
  Add('// adds the Server.Resources.* resources.');
  Add;
  Add('interface');
  Add;
  LUnits := [];
  for var LResource in FServer.Resources do
    LUnits := LUnits + [LResource.ResourceUnit];
  if Length(LUnits) > 0 then
  begin
    Add('uses');
    Add(INDENT + string.Join(sLineBreak + ', ', LUnits));
    Add(';');
    Add;
  end;
  Add('implementation');
  Add;
  Add('end.');
  Result := FLines.Text;
end;

class function TGenServerEmitter.WriteServer(const AApi: TGenApi; const AOptions: TGenTypeOptions;
  const AFolder: string): TGenServerFiles;
var
  LTypes: TGenTypeMapper;
  LServer: TGenServerMapper;
  LEmitter: TGenServerEmitter;
  LFile: string;
begin
  Result.Written := [];
  Result.Created := [];
  Result.Kept := [];
  ForceDirectories(AFolder);

  LTypes := TGenTypeMapper.Create(AApi, AOptions);
  try
    LTypes.Execute;
    LServer := TGenServerMapper.Create(AApi, LTypes);
    try
      LServer.Execute;

      LFile := TPath.Combine(AFolder, LTypes.UnitName + '.pas');
      TFile.WriteAllText(LFile, TGenTypesEmitter.Emit(LTypes), TEncoding.UTF8);
      Result.Written := Result.Written + [LFile];

      LEmitter := TGenServerEmitter.Create(LServer);
      try
        for var LResource in LServer.Resources do
        begin
          LFile := TPath.Combine(AFolder, LResource.BaseUnit + '.pas');
          TFile.WriteAllText(LFile, LEmitter.BaseUnit(LResource), TEncoding.UTF8);
          Result.Written := Result.Written + [LFile];

          // the code of the user: never written again
          LFile := TPath.Combine(AFolder, LResource.ResourceUnit + '.pas');
          if TFile.Exists(LFile) then
            Result.Kept := Result.Kept + [LFile]
          else
          begin
            TFile.WriteAllText(LFile, LEmitter.UserUnit(LResource), TEncoding.UTF8);
            Result.Created := Result.Created + [LFile];
          end;
        end;

        LFile := TPath.Combine(AFolder, LServer.ApiUnitName + '.pas');
        TFile.WriteAllText(LFile, LEmitter.ApiUnit, TEncoding.UTF8);
        Result.Written := Result.Written + [LFile];
      finally
        LEmitter.Free;
      end;
    finally
      LServer.Free;
    end;
  finally
    LTypes.Free;
  end;
end;

end.
